<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="8dp">
        <ImageView android:contentDescription="@string/image_placeholder" android:id="@+id/compare_image_a" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="centerInside" android:background="@drawable/card_paper"/>
        <TextView android:id="@+id/compare_text_a" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="0dp" android:paddingStart="8dp">
        <ImageView android:contentDescription="@string/image_placeholder" android:id="@+id/compare_image_b" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="centerInside" android:background="@drawable/card_paper"/>
        <TextView android:id="@+id/compare_text_b" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
