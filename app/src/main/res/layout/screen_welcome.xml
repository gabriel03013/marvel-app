<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_cream">

    <ScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/welcome_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="67dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/collage_paper_label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:minHeight="67dp"
                        android:paddingStart="20dp"
                        android:text="S.H.I.E.L.D."
                        android:textColor="@color/ink_black"
                        android:textSize="24sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/bebas_neue"
                    android:includeFontPadding="false"
                    android:text="ARCHIVES"
                    android:textColor="@color/ink_black"
                    android:textSize="48sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/collage_heroes" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/oswald"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/welcome_copy"
                    android:textColor="@color/ink_black"
                    android:textSize="24sp" />

                <LinearLayout
                    android:id="@+id/welcome_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/sign_in"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:minHeight="56dp"
                        android:singleLine="false"
                        android:text="@string/google_sign_in"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/email_sign_in"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="0dp"
                        android:background="@drawable/button_outline"
                        android:minHeight="56dp"
                        android:singleLine="false"
                        android:text="Sign in with email"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/create_account"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="0dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:singleLine="false"
                        android:text="Create an account"
                        android:textColor="@color/archive_red"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/anonymous_sign_in"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="0dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:singleLine="false"
                        android:text="@string/anonymous_sign_in"
                        android:textColor="@color/archive_red"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/sign_in_loading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:contentDescription="Signing in"
                        android:indeterminateTint="@color/archive_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/sign_in_error"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/deep_red" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/space_grotesk"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/privacy_note"
                    android:textColor="@color/muted_ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
