<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/archive_black">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/archive_background" android:scaleType="centerCrop"
        android:importantForAccessibility="no" android:alpha="0.16" />
    <ScrollView android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:gravity="center">
            <LinearLayout android:id="@+id/welcome_content"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/archive_red" android:fontFamily="@font/bebas_neue"
                    android:gravity="center" android:paddingHorizontal="16dp" android:paddingVertical="4dp"
                    android:text="S.H.I.E.L.D." android:textColor="@color/warm_white" android:textSize="40sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:accessibilityHeading="true" android:fontFamily="@font/bebas_neue"
                    android:gravity="center" android:includeFontPadding="false" android:layout_marginTop="8dp"
                    android:text="ARCHIVES" android:textColor="@color/paper_cream" android:textSize="64sp" />
                <com.example.marvel.ui.CollageArtView android:layout_width="match_parent"
                    android:layout_height="148dp" android:importantForAccessibility="no" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed" android:gravity="center"
                    android:text="@string/tagline" android:textColor="@color/comic_yellow"
                    android:textSize="20sp" android:layout_marginBottom="20dp" />
                <LinearLayout android:id="@+id/welcome_actions"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/paper_cream" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald" android:lineSpacingExtra="4dp"
                        android:text="@string/welcome_copy" android:textColor="@color/ink_black"
                        android:textSize="24sp" android:layout_marginBottom="16dp" />
                    <Button android:id="@+id/sign_in" style="@style/ArchiveButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:text="@string/google_sign_in" android:textSize="16sp" />
                    <Button android:id="@+id/email_sign_in" style="@style/ArchiveButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/button_outline" android:minHeight="56dp"
                        android:text="Sign in with email" android:textColor="@color/ink_black" android:textSize="16sp" />
                    <Button android:id="@+id/create_account" style="@style/ArchiveButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground" android:minHeight="48dp"
                        android:text="Create an account" android:textColor="@color/deep_red" android:textSize="16sp" />
                    <ProgressBar android:id="@+id/sign_in_loading"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
                        android:contentDescription="Signing in" android:indeterminateTint="@color/archive_red"
                        android:visibility="gone" />
                    <TextView android:id="@+id/sign_in_error" style="@style/BodyText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp"
                        android:textColor="@color/deep_red" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:lineSpacingExtra="4dp"
                    android:text="@string/privacy_note" android:textColor="@color/stage_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
