<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginVertical="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="App-generated evaluation" android:textSize="16sp" android:textColor="@color/ink_black"/>
    <TextView android:id="@+id/score_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/bebas_neue" android:textSize="64sp" android:textColor="@color/ink_black"/>
    <TextView android:id="@+id/score_copy" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
