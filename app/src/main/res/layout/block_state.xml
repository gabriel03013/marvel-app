<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginVertical="16dp" android:background="@drawable/card_paper">
    <com.example.marvel.ui.CollageArtView android:layout_width="match_parent" android:layout_height="48dp" android:importantForAccessibility="no"/>
    <ProgressBar android:id="@+id/state_loading" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
    <TextView android:id="@+id/state_title" style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp"/>
    <TextView android:id="@+id/state_copy" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
    <include layout="@layout/block_skeleton"/>
    <Button android:id="@+id/state_retry" style="@style/ArchiveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone"/>
</LinearLayout>
