<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="116dp" android:orientation="horizontal" android:background="@drawable/card_paper" android:foreground="?android:attr/selectableItemBackground" android:padding="16dp" android:focusable="true" android:layout_marginBottom="12dp" android:gravity="center_vertical">
    <ImageView android:contentDescription="@string/image_placeholder" android:id="@+id/record_image" android:layout_width="80dp" android:layout_height="104dp" android:scaleType="centerCrop" android:background="@color/paper_cream" android:src="@drawable/ic_dossier"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="0dp">
        <TextView android:id="@+id/record_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/oswald" android:textColor="@color/ink_black" android:textSize="22sp"/>
        <TextView android:id="@+id/record_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/archive_blue" android:textSize="13sp" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/record_deck" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink_gray" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/record_selected" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/deep_red" android:textSize="14sp" android:text="@string/selected_member" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
