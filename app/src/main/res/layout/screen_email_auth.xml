<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_cream">

    <ScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/auth_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/auth_back"
                    style="@style/ArchiveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_back"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/ink_black"
                    android:minHeight="48dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="16dp"
                    android:singleLine="false"
                    android:text="@string/back"
                    android:textColor="@color/ink_black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/auth_title"
                        style="@style/ArchiveTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink_black"
                        android:textSize="44sp" />

                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/collage_heroes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/auth_form_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@color/warm_white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/auth_copy"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/muted_ink" />

                    <TextView
                        android:id="@+id/auth_name_label"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:labelFor="@+id/auth_name"
                        android:text="Agent name"
                        android:textColor="@color/ink_black" />

                    <EditText
                        android:id="@id/auth_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:background="@drawable/field_background"
                        android:fontFamily="@font/space_grotesk"
                        android:hint="Enter your name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:tag="auth_name"
                        android:textColor="@color/ink_black"
                        android:textColorHint="@color/muted_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/auth_email_label"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:labelFor="@+id/auth_email"
                        android:text="Email address"
                        android:textColor="@color/ink_black" />

                    <EditText
                        android:id="@id/auth_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:background="@drawable/field_background"
                        android:fontFamily="@font/space_grotesk"
                        android:hint="Enter your email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:tag="auth_email"
                        android:textColor="@color/ink_black"
                        android:textColorHint="@color/muted_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/auth_password_label"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:labelFor="@+id/auth_password"
                        android:text="Password"
                        android:textColor="@color/ink_black" />

                    <EditText
                        android:id="@id/auth_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:background="@drawable/field_background"
                        android:fontFamily="@font/space_grotesk"
                        android:hint="Enter your password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:tag="auth_password"
                        android:textColor="@color/ink_black"
                        android:textColorHint="@color/muted_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/auth_confirm_label"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:labelFor="@+id/auth_confirm"
                        android:text="Confirm password"
                        android:textColor="@color/ink_black" />

                    <EditText
                        android:id="@id/auth_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:background="@drawable/field_background"
                        android:fontFamily="@font/space_grotesk"
                        android:hint="Re-enter your password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:tag="auth_confirm"
                        android:textColor="@color/ink_black"
                        android:textColorHint="@color/muted_ink"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/auth_show_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="@color/archive_red"
                        android:fontFamily="@font/space_grotesk"
                        android:minHeight="48dp"
                        android:text="Show passwords"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/auth_feedback"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:accessibilityLiveRegion="polite"
                        android:background="@color/paper_cream"
                        android:padding="12dp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/auth_progress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:contentDescription="Processing account request"
                        android:indeterminateTint="@color/archive_red"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/auth_submit"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="0dp"
                        android:minHeight="56dp"
                        android:singleLine="false"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/auth_reset"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="0dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:singleLine="false"
                        android:text="Forgot password?"
                        android:textColor="@color/archive_red"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/auth_alternative"
                        style="@style/ArchiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="0dp"
                        android:background="@drawable/button_outline"
                        android:minHeight="56dp"
                        android:singleLine="false"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
