    <item><shape><solid android:color="@color/warm_white"/><stroke android:width="1dp" android:color="@color/muted_ink"/><corners android:radius="8dp"/><padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp"/></shape></item>
